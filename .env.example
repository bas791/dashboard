# ─── Data source ──────────────────────────────────────────────────────────────
# "mock"  → built-in simulator, no credentials needed (default for development)
# "ghl"   → live GoHighLevel API
DATA_SOURCE=mock

# ─── GoHighLevel API (required when DATA_SOURCE=ghl) ─────────────────────────
# Private Integration token (Settings → Private Integrations in GHL).
# Needs scopes: contacts.readonly, opportunities.readonly, conversations.readonly, users.readonly
GHL_API_KEY=
# The sub-account (location) ID this dashboard shows
GHL_LOCATION_ID=
# API base URL — override only if GHL changes versions
GHL_API_BASE_URL=https://services.leadconnectorhq.com
GHL_API_VERSION=2021-07-28

# The pipeline whose stages map to dashboard statuses (optional — first pipeline is used if empty)
GHL_PIPELINE_ID=

# Which dashboard location (id from src/config/team.ts) this GHL sub-account
# belongs to (optional — defaults to the first configured location)
GHL_DASHBOARD_LOCATION_ID=

# How often the server polls GoHighLevel, in milliseconds
GHL_POLL_INTERVAL_MS=15000

# ─── Dashboard behaviour ─────────────────────────────────────────────────────
# SLA thresholds in minutes (green below warn, orange below breach, red above)
SLA_WARN_MINUTES=5
SLA_BREACH_MINUTES=10

# IANA timezone used to decide what "today" means for the wallboard
DASHBOARD_TIMEZONE=Pacific/Auckland
